APP_NAME=Pilahin API
DEBUG=true

# Swagger UI (/docs), ReDoc (/redoc) and the raw OpenAPI schema
# (/openapi.json). Set to false to hide the API surface in production.
ENABLE_DOCS=true

# Comma-separated list is not supported by default; edit config.py if you
# need to load this from env instead of the hardcoded default.
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# PostgreSQL (see app/db.py). `docker compose up` runs a matching `db`
# service for this default; point at a different instance if running the
# backend outside compose (this is a template — put your own value in a
# real, gitignored `.env`, never a live connection string here).
DATABASE_URL=""
# "cpu" | "mps" | "cuda"
ML_DEVICE=cpu

# LLM report generation (/report endpoint, see app/services/llm/).
# "openai" | "claude" | "ollama" — ollama needs no key but requires a local
# `ollama serve` with LLM_MODEL already pulled.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# Only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only needed when LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
